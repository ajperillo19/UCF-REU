&CONTROL
! .control.settings
calculation               = 'relax',
restart_mode              = 'from_scratch',
prefix                    = 'scf',
pseudo_dir                = '/shared/ESPRESSO/PSLIBRARY/1.0.0/pbe/PSEUDOPOTENTIALS/',

! .control.io
outdir                    = './tmp/',
verbosity                 = 'low',
disk_io                   = 'default',
wf_collect                = .false.,

! .control.ion_relax
tprnfor                   = .true.,
tstress                   = .true.,
forc_conv_thr             = 0.001,
etot_conv_thr             = 0.0001,
nstep                     = 100,
/

&SYSTEM
! .system.structure
ibrav                     = 0,
nat                       = 4,
ntyp                      = 3,

! .system.ecut
ecutwfc                   = 70.0,
ecutrho                   = 700,

! .system.occupations 
occupations               = 'smearing',
smearing                  = 'gauss',
degauss                   = 0.0073498586,
starting_magnetization(3) = 0.8,
nspin                     = 2,
vdw_corr                  = 'DFT-D3',

! .system.additional_keywords
tot_charge                = 0,
/

&ELECTRONS
! .electrons
diagonalization           = 'david',
conv_thr                  = 1e-06,
electron_maxstep          = 100,
mixing_mode               = 'plain',
mixing_beta               = 0.7,
/

&IONS
! .ions
ion_dynamics              = 'bfgs',
wfc_extrapolation         = 'none',
pot_extrapolation         = 'atomic',
/
! .atomic_species
ATOMIC_SPECIES
   Mo  95.9400 Mo.pbe-spn-kjpaw_psl.1.0.0.UPF
    S  32.0650 S.pbe-n-kjpaw_psl.1.0.0.UPF
   Co  58.9332 Co.pbe-n-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS  crystal 
 Mo     0.00000000000000     0.00000000000000     0.38000000089213   1   1   1
  S     0.66666666670000     0.33333333330000     0.44266243849524   1   1   1
  S     0.66666666670000     0.33333333330000     0.31733756328902   1   1   1
 Co     0.82690718036937     0.89554762557683     0.52266243849524   1   1   1
CELL_PARAMETERS angstrom
    3.16511313107258     0.00000000000000     0.00000000000000
   -1.58255656553629     2.74106709933713     0.00000000000000
    0.00000000000000     0.00000000000000    25.00000000000000

! .kpoints
K_POINTS automatic   ! .kpoints.type 
  12   12    1   0   0   0 ! .kpoints.mesh and .kpoints.smesh
