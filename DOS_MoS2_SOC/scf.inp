&CONTROL
! .control.settings
calculation               = 'scf',
restart_mode              = 'from_scratch',
prefix                    = 'scf',
pseudo_dir                = '/apps/softwares/qe/PP/1.0.0_2019/rel-pbe/PSEUDOPOTENTIALS/',

! .control.io
outdir                    = './tmp/',
verbosity                 = 'low',
disk_io                   = 'med',
wf_collect                = .false.,

! .control.ion_relax
tprnfor                   = .true.,
tstress                   = .true.,
forc_conv_thr             = 0.001,
etot_conv_thr             = 0.0001,
nstep                     = 100,
/

&SYSTEM
! .system.structure
ibrav                     = 0,
nat                       = 3,
ntyp                      = 2,

! .system.ecut
ecutwfc                   = 70,
ecutrho                   = 700,

! .system.occupations 
occupations               = 'smearing',
smearing                  = 'gauss',
degauss                   = 0.0073498586,
lspinorb                  = .true.,
noncolin                  = .true.,
vdw_corr                  = 'DFT-D3',

! .system.additional_keywords
tot_charge                = 0,
/

&ELECTRONS
! .electrons
diagonalization           = 'david',
conv_thr                  = 1e-06,
electron_maxstep          = 100,
mixing_mode               = 'plain',
mixing_beta               = 0.7,
/

! .atomic_species
ATOMIC_SPECIES
   Mo  95.9400 Mo.rel-pbe-spn-kjpaw_psl.1.0.0.UPF
    S  32.0650 S.rel-pbe-n-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS  crystal 
 Mo     0.00000000000000     0.00000000000000     0.50000000000000   1   1   1
  S     0.66666666670000     0.33333333330000     0.58245057560000   1   1   1
  S     0.66666666670000     0.33333333330000     0.41754942440000   1   1   1
CELL_PARAMETERS angstrom
    3.16511313107258     0.00000000000000     0.00000000000000
   -1.58255656553629     2.74106709933713     0.00000000000000
    0.00000000000000     0.00000000000000    19.00000004460647

! .kpoints
K_POINTS automatic   ! .kpoints.type 
   9    9    1   0   0   0 ! .kpoints.mesh and .kpoints.smesh
