&CONTROL
! .control.settings
calculation               = 'scf',
restart_mode              = 'from_scratch',
prefix                    = 'pwscf',
pseudo_dir                = '/apps/softwares/qe/PP/1.0.0_2019/rel-pbe/PSEUDOPOTENTIALS/',

! .control.io
outdir                    = './tmp/',
verbosity                 = 'low',
disk_io                   = 'low',
wf_collect                = .false.,

! .control.ion_relax
tprnfor                   = .true.,
tstress                   = .true.,
forc_conv_thr             = 0.001,
etot_conv_thr             = 0.0001,
nstep                     = 100,
/

&SYSTEM
! .system.structure
ibrav                     = 0,
nat                       = 4,
ntyp                      = 3,

! .system.ecut
ecutwfc                   = 70.0,
ecutrho                   = 700.0,

! .system.occupations 
occupations               = 'smearing',
smearing                  = 'gauss',
degauss                   = 0.0073498586,
vdw_corr                  = 'DFT-D3',
starting_magnetization(3) = 0,
noncolin                  = .true.,
lspinorb                  = .true.,
nosym			  = .true.,
noinv			  = .true.,


! .system.additional_keywords
tot_charge                = 0,
/

&ELECTRONS
! .electrons
diagonalization           = 'david',
conv_thr                  = 1e-06,
electron_maxstep          = 100,
mixing_mode               = 'plain',
mixing_beta               = 0.7,
/

! .atomic_species
ATOMIC_SPECIES
   Mo  95.9400 Mo.rel-pbe-spn-rrkjus_psl.1.0.0.UPF
    S  32.0650 S.rel-pbe-n-rrkjus_psl.1.0.0.UPF
   Co  58.9332 Co.rel-pbe-n-rrkjus_psl.1.0.0.UPF

ATOMIC_POSITIONS  crystal 
 Mo     0.00000000000000     0.00000000000000     0.38713944870000   1   1   1
  S     0.66666666670000     0.33333333330000     0.45591397910000   1   1   1
  S     0.66666666670000     0.33333333330000     0.32540903660000   1   1   1
 Co     0.00000000000000     0.00000000000000     0.49419997680000   1   1   1
CELL_PARAMETERS angstrom
    3.16511313107258     0.00000000000000     0.00000000000000
   -1.58255656553629     2.74106709933713     0.00000000000000
    0.00000000000000     0.00000000000000    25.00000055844742

! .kpoints
K_POINTS automatic   ! .kpoints.type 
  10   10    1   0   0   0 ! .kpoints.mesh and .kpoints.smesh
