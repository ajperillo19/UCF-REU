&CONTROL
! .control.settings
calculation               = 'relax',
restart_mode              = 'from_scratch',
prefix                    = 'scf',
pseudo_dir                = '/shared/ESPRESSO/PSLIBRARY/1.0.0/pbe/PSEUDOPOTENTIALS/',

! .control.io
outdir                    = './tmp/',
verbosity                 = 'low',
disk_io                   = 'default',
wf_collect                = .false.,

! .control.ion_relax
tprnfor                   = .true.,
tstress                   = .true.,
forc_conv_thr             = 0.001,
etot_conv_thr             = 0.0001,
nstep                     = 100,
/

&SYSTEM
! .system.structure
ibrav                     = 0,
nat                       = 3,
ntyp                      = 2,

! .system.ecut
ecutwfc                   = 70,
ecutrho                   = 700,

! .system.occupations 
occupations               = 'smearing',
smearing                  = 'gauss',
degauss                   = 0.0073498586,
vdw_corr                  = 'DFT-D3',


! .system.additional_keywords
tot_charge                = 0,
/

&ELECTRONS
! .electrons
diagonalization           = 'david',
conv_thr                  = 1e-06,
electron_maxstep          = 100,
mixing_mode               = 'plain',
mixing_beta               = 0.7,
/

&IONS
! .ions
ion_dynamics              = 'damp',
wfc_extrapolation         = 'none',
pot_extrapolation         = 'atomic',
/
! .atomic_species
ATOMIC_SPECIES
   Mo  95.9400 Mo.pbe-spn-kjpaw_psl.1.0.0.UPF
    S  32.0650 S.pbe-n-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS  crystal 
 Mo     0.00000000000000     0.00000000000000     0.50000000000000   1   1   1
  S     0.66666666666667     0.33333333333333     0.60526315789474   1   1   1
  S     0.66666666666667     0.33333333333333     0.39473684210526   1   1   1
CELL_PARAMETERS angstrom
    3.13000000000000     0.00000000000000     0.00000000000000
   -1.56500000000000     2.71065951384529     0.00000000000000
    0.00000000000000    -0.00000000000000    19.00000000000000

! .kpoints
K_POINTS automatic   ! .kpoints.type 
   9    9    1   0   0   0 ! .kpoints.mesh and .kpoints.smesh
