&CONTROL
! .control.settings
calculation               = 'bands',
restart_mode              = 'from_scratch',
prefix                    = 'pwscf',
pseudo_dir                = '/shared/ESPRESSO/PSLIBRARY/1.0.0/pbe/PSEUDOPOTENTIALS/',

! .control.io
outdir                    = './tmp/',
verbosity                 = 'low',
disk_io                   = 'high',
wf_collect                = .false.,

! .control.ion_relax
tprnfor                   = .true.,
tstress                   = .true.,
forc_conv_thr             = 0.001,
etot_conv_thr             = 0.0001,
nstep                     = 100,
/

&SYSTEM
! .system.structure
ibrav                     = 0,
nat                       = 2,
ntyp                      = 1,

! .system.ecut
ecutwfc                   = 65.0,
ecutrho                   = 260.0,

! .system.occupations 
occupations               = 'smearing',
smearing                  = 'fd',
degauss                   = 0.007,
starting_magnetization    = 0.8,
nspin                     = 2,

! .system.additional_keywords
tot_charge                = 0,
/

&ELECTRONS
! .electrons
diagonalization           = 'david',
conv_thr                  = 1e-06,
electron_maxstep          = 100,
mixing_mode               = 'plain',
mixing_beta               = 0.7,
/

! .atomic_species
ATOMIC_SPECIES
   Co  58.9332 Co.pbe-n-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS  crystal 
 Co     0.00000000000000     0.00000000000000     0.00000000000000   1   1   1
 Co     0.33333333333333     0.66666666666667     0.50000000000000   1   1   1
CELL_PARAMETERS angstrom
    2.45000000000000     0.00000000000000     0.00000000000000
   -1.22500000000000     2.12176223927187     0.00000000000000
    0.00000000000000     0.00000000000000     3.98744850000000

! .kpoints
K_POINTS automatic   ! .kpoints.type 
  13   13    1   0   0   0 ! .kpoints.mesh and .kpoints.smesh
