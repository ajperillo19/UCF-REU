&CONTROL
! .control.settings
calculation               = 'nscf',
restart_mode              = 'from_scratch',
prefix                    = 'scf',
pseudo_dir                = '/apps/softwares/qe/PP/1.0.0_2019/rel-pbe/PSEUDOPOTENTIALS//',

! .control.io
outdir                    = './tmp/',
verbosity                 = 'low',
disk_io                   = 'default',
wf_collect                = .false.,

! .control.ion_relax
tprnfor                   = .true.,
tstress                   = .true.,
forc_conv_thr             = 0.001,
etot_conv_thr             = 0.0001,
nstep                     = 100,
/

&SYSTEM
! .system.structure
ibrav                     = 0,
nat                       = 1,
ntyp                      = 1,

! .system.ecut
ecutwfc                   = 70,
ecutrho                   = 700,

! .system.occupations 
occupations               = 'smearing',
smearing                  = 'gauss',
degauss                   = 0.0073498586,
vdw_corr                  = 'DFT-D3',
starting_magnetization    = 0.8,
lspinorb                  = .true,
noncolin                  = .true,

! .system.additional_keywords
tot_charge                = 0,
/

&ELECTRONS
! .electrons
diagonalization           = 'david',
conv_thr                  = 1e-06,
electron_maxstep          = 100,
mixing_mode               = 'plain',
mixing_beta               = 0.7,
/

! .atomic_species
ATOMIC_SPECIES
