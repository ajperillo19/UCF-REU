&CONTROL
! .control.settings
calculation               = 'scf',
restart_mode              = 'from_scratch',
prefix                    = 'scf',
pseudo_dir                = '/shared/ESPRESSO/PSLIBRARY/1.0.0/pbe/PSEUDOPOTENTIALS/',

! .control.io
outdir                    = './tmp/',
verbosity                 = 'low',
disk_io                   = 'default',
wf_collect                = .false.,

! .control.ion_relax
tprnfor                   = .true.,
tstress                   = .true.,
forc_conv_thr             = 0.001,
etot_conv_thr             = 0.0001,
nstep                     = 100,
/

&SYSTEM
! .system.structure
ibrav                     = 0,
nat                       = 2,
ntyp                      = 1,

! .system.ecut
ecutwfc                   = 20.0,
ecutrho                   = 80.0,

! .system.occupations 
occupations               = 'smearing',
smearing                  = 'fd',
degauss                   = 0.007,

! .system.additional_keywords
tot_charge                = 0,
/

&ELECTRONS
! .electrons
diagonalization           = 'david',
conv_thr                  = 1e-06,
electron_maxstep          = 100,
mixing_mode               = 'plain',
mixing_beta               = 0.7,
/

! .atomic_species
ATOMIC_SPECIES
    C  12.1000 C.pbe-n-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS  crystal 
  C     0.00000000000000     0.00000000000000     0.00000000000000   1   1   1
  C     0.66699188370358     0.33349596252911     0.00000000000000   1   1   1
CELL_PARAMETERS angstrom
    2.46000000000000     0.00000000000000     0.00000000000000
   -1.23000000000000     2.13042249330972     0.00000000000000
    0.00000000000000     0.00000000000000     6.70900000000000

! .kpoints
K_POINTS automatic   ! .kpoints.type 
  16   16   16   0   0   0 ! .kpoints.mesh and .kpoints.smesh
